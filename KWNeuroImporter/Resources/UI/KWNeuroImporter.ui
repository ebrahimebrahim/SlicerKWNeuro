<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>KWNeuroImporter</class>
 <widget class="qMRMLWidget" name="KWNeuroImporter">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>480</width>
    <height>420</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="ctkCollapsibleButton" name="importDwiCollapsibleButton">
     <property name="text">
      <string>Import DWI from disk</string>
     </property>
     <layout class="QFormLayout" name="importDwiFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="volumeLabel">
        <property name="text">
         <string>NIfTI volume:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="ctkPathLineEdit" name="volumePathLineEdit">
        <property name="toolTip">
         <string>4D NIfTI file containing the diffusion-weighted volumes.</string>
        </property>
        <property name="nameFilters">
         <stringlist>
          <string>NIfTI (*.nii *.nii.gz)</string>
         </stringlist>
        </property>
        <property name="filters">
         <set>ctkPathLineEdit::Files|ctkPathLineEdit::Readable</set>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="bvalLabel">
        <property name="text">
         <string>FSL bval file:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="ctkPathLineEdit" name="bvalPathLineEdit">
        <property name="toolTip">
         <string>FSL-style .bval file listing the b-value for each gradient direction.</string>
        </property>
        <property name="nameFilters">
         <stringlist>
          <string>FSL b-values (*.bval)</string>
          <string>All files (*)</string>
         </stringlist>
        </property>
        <property name="filters">
         <set>ctkPathLineEdit::Files|ctkPathLineEdit::Readable</set>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="bvecLabel">
        <property name="text">
         <string>FSL bvec file:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="ctkPathLineEdit" name="bvecPathLineEdit">
        <property name="toolTip">
         <string>FSL-style .bvec file listing the gradient direction for each volume.</string>
        </property>
        <property name="nameFilters">
         <stringlist>
          <string>FSL b-vectors (*.bvec)</string>
          <string>All files (*)</string>
         </stringlist>
        </property>
        <property name="filters">
         <set>ctkPathLineEdit::Files|ctkPathLineEdit::Readable</set>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="nameLabel">
        <property name="text">
         <string>Node name:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QLineEdit" name="nameLineEdit">
        <property name="toolTip">
         <string>Name for the created vtkMRMLDiffusionWeightedVolumeNode in the scene.</string>
        </property>
        <property name="text">
         <string>dwi</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QPushButton" name="loadButton">
        <property name="text">
         <string>Load DWI</string>
        </property>
        <property name="toolTip">
         <string>Read the three files from disk and push a vtkMRMLDiffusionWeightedVolumeNode into the scene using InSceneDwi.from_nifti_path. Unlike Slicer's built-in Add Data, this preserves the 4th dimension and attaches gradient + b-value metadata to the node.</string>
        </property>
        <property name="enabled">
         <bool>false</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="importStructuralCollapsibleButton">
     <property name="text">
      <string>Import structural image from disk</string>
     </property>
     <layout class="QFormLayout" name="importStructuralFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="structuralPathLabel">
        <property name="text">
         <string>NIfTI volume:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="ctkPathLineEdit" name="structuralPathLineEdit">
        <property name="toolTip">
         <string>3D NIfTI file containing a structural image such as a T1-weighted volume.</string>
        </property>
        <property name="nameFilters">
         <stringlist>
          <string>NIfTI (*.nii *.nii.gz)</string>
         </stringlist>
        </property>
        <property name="filters">
         <set>ctkPathLineEdit::Files|ctkPathLineEdit::Readable</set>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="structuralNameLabel">
        <property name="text">
         <string>Node name:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="structuralNameLineEdit">
        <property name="toolTip">
         <string>Name for the created vtkMRMLScalarVolumeNode in the scene.</string>
        </property>
        <property name="text">
         <string>t1</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QPushButton" name="loadStructuralButton">
        <property name="text">
         <string>Load structural image</string>
        </property>
        <property name="toolTip">
         <string>Read the NIfTI file from disk and push a vtkMRMLScalarVolumeNode into the scene using InSceneStructuralImage.</string>
        </property>
        <property name="enabled">
         <bool>false</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="sampleDataCollapsibleButton">
     <property name="text">
      <string>Sample data</string>
     </property>
     <layout class="QVBoxLayout" name="sampleDataLayout">
      <item>
       <widget class="QPushButton" name="loadSherbrookeButton">
        <property name="text">
         <string>Load Sherbrooke 3-shell (HARDI193, ~30 MB)</string>
        </property>
        <property name="toolTip">
         <string>Download (if needed) and load dipy's Sherbrooke 3-shell diffusion dataset as a vtkMRMLDiffusionWeightedVolumeNode named HARDI193. Cached at ~/.dipy/sherbrooke_3shell/ after the first download (~30 MB). Good for DTI / NODDI demos; TractSeg gives sparse output on it.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="loadCenirButton">
        <property name="text">
         <string>Load CENIR multi-shell (b=1000/2000/3000, ~1.7 GB)</string>
        </property>
        <property name="toolTip">
         <string>Download (if needed) and load the CENIR multi-shell HARDI dataset (UW ResearchWorks 1773/33311) via dipy's fetcher, concatenated to the b=1000/2000/3000 shells. Cached at ~/.dipy/cenir_multib/ after the first download (~1.7 GB total across three per-shell files). Substantially denser TractSeg bundles than Sherbrooke. Each load takes ~15 seconds for the disk read + concat (we don't cache the concatenated file).</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="loadEddenButton">
        <property name="text">
         <string>Load EDDEN HCP-protocol DWI (sub-01, ~1.8 GB)</string>
        </property>
        <property name="toolTip">
         <string>Download (if needed) and load the EDDEN single-subject HCP-protocol DWI (OpenNeuro ds004666 sub-01 ses-1p5mm AVG_complex derivative). 270 directions across b=1000/2000/3000 at 1.5 mm isotropic — the closest publicly redistributable match to the HCP-YA acquisition TractSeg was trained on. CC0 license. Cached at ~/.kwneuro_sample_data/edden_ds004666_ses-1p5mm/ after the first ~1.8 GB download.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="loadDs000221Button">
        <property name="text">
         <string>Load ds000221 T1 + DWI (sub-010002 ses-01)</string>
        </property>
        <property name="toolTip">
         <string>Download (if needed) and load the OpenNeuro ds000221 LEMON subject sub-010002 ses-01 structural T1w image plus DWI NIfTI, bval, and bvec. Cached at ~/.kwneuro_sample_data/ds000221_sub-010002_ses-01/ after the first download.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="resultLabel">
     <property name="text">
      <string>(nothing loaded)</string>
     </property>
     <property name="textInteractionFlags">
      <set>Qt::TextSelectableByMouse</set>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
